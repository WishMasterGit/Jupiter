{
  "permissions": {
    "allow": [
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "WebSearch",
      "Bash(cargo check:*)",
      "Bash(grep:*)",
      "Bash(cargo clippy:*)",
      "WebFetch(domain:sites.google.com)",
      "WebFetch(domain:www.astrokraai.nl)",
      "WebFetch(domain:www.lost-infinity.com)",
      "WebFetch(domain:www.cambridge.org)",
      "WebFetch(domain:skyinspector.co.uk)",
      "WebFetch(domain:www.astroshop.eu)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:www.cloudynights.com)",
      "WebFetch(domain:siril.readthedocs.io)",
      "WebFetch(domain:astroforumspace.com)",
      "Bash(curl:*)",
      "Bash(act:*)",
      "Bash(echo:*)",
      "Bash(sudo act:*)",
      "Bash(security find-identity:*)",
      "Bash(security list-keychains:*)",
      "Bash(security find-certificate:*)",
      "Bash(openssl x509:*)",
      "Bash(tee:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(cargo fmt:*)",
      "Bash(gh release:*)",
      "Bash(cargo release:*)",
      "Bash(cargo add:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(chmod:*)",
      "Bash(git:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_PARAM_file_path\" | grep -q '\\.rs$'; then cd /Users/wmts/repo/astro/jupiter && cargo fmt --all --quiet 2>/dev/null; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_PARAM_command\" | grep -q '^cargo test'; then echo '💡 Reminder: run cargo llvm-cov to check coverage after test changes'; fi"
          }
        ]
      }
    ]
  }
}
